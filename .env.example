# ─────────────────────────────────────────────────────────────────────
# Academic Hub — environment template
# Copy to `.env` for local dev, and mirror the values into your host's
# dashboard for deployment (Vercel → Project Settings → Environment
# Variables). Never commit a real .env file.
# ─────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────
# Postgres connection string. Local dev: `npm run services:up` prints one
# (or see scripts/services.mjs). Demo on Vercel: a Neon free-tier
# database, e.g. postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require
#
# IMPORTANT for hosted Postgres (Neon/Supabase): use the POOLED connection
# for the app (host contains -pooler) with ?pgbouncer=true appended, e.g.
#   postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/db?sslmode=require&pgbouncer=true
# Neon closes idle direct connections, which breaks Prisma interactive
# transactions (P2028). Keep the DIRECT connection for `prisma migrate
# deploy` and other one-off scripts.
DATABASE_URL=

# ── Object storage (private PDFs + rendered pages) ───────────────────
# The app stores every PDF and page image in an S3-compatible private
# bucket — nothing is ever public. Local dev: MinIO (set by
# `npm run services:up`). For deployment:
#   • Cloudflare R2:    S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#                       S3_REGION=auto   (R2 API token needs Object Read & Write)
#   • Supabase Storage: S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   • Real AWS S3:      leave S3_ENDPOINT empty
# Omit S3_ENDPOINT to use real AWS S3.
# CREATE THE BUCKET YOURSELF FIRST (S3_BUCKET below) — most providers
# reject the app's automatic bucket creation.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=pastq-private

# ── App ──────────────────────────────────────────────────────────────
# Canonical origin of this deployment (no trailing slash). Used for
# absolute watermark/PDF URLs and payment callbacks.
#   Local dev:  http://localhost:3000
#   Vercel:     https://your-app.vercel.app
APP_ORIGIN=http://localhost:3000

# Any long random string (e.g. `openssl rand -hex 32`). Signs the
# per-page secure-viewer tokens.
PAGE_TOKEN_SECRET=

# ── Payments ─────────────────────────────────────────────────────────
# "mock" (default) = built-in sandbox gateway, completes instantly with
# no real money — perfect for a demo. Swap to a real provider name once
# one is wired (e.g. "moolre").
PAYMENT_PROVIDER=mock

# HMAC secret shared with the provider's webhook. The built-in sandbox
# is self-consistent without one; SET IT when a real provider starts
# signing webhooks, or webhook delivery is rejected.
PAYMENT_WEBHOOK_SECRET=

# ── Moolre (when PAYMENT_PROVIDER=moolre) ──────────────────────────────
# Credentials from your Moolre dashboard (developer tools).
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
# Override only for sandbox testing; defaults to https://api.moolre.com
# MOOLRE_API_BASE=https://api.moolre.com
# Comma-separated allowlist of Moolre callback source IPs; defaults to
# the published POS-callback address.
# MOOLRE_CALLBACK_IPS=174.138.44.22

# ── Optional branding / overrides ────────────────────────────────────
# NEXT_PUBLIC_APP_NAME=Academic Resource Hub
# NEXT_PUBLIC_PAYMENT_RETURN_URL=https://your-app.vercel.app/api/payments/verify
