# Keep the build context lean and safe. Without this file, a host-side
# node_modules in the repo directory gets copied OVER the image's own
# freshly-installed one during `COPY . .` (stale Prisma client bug), and
# deploy/.env.production secrets would be baked into the image.
node_modules
.next
out
.git
.gitignore
services
*.log
npm-debug.log*

.env
.env.*
!.env.example
deploy/.env
deploy/.env.production