# Academic Hub — VPS production env (copy to deploy/.env.production and edit).

# ── Compose-only ─────────────────────────────────────────────────────
# Postgres superuser password for the postgres container (any strong value).
PG_PASSWORD=change-me

# ── Database ────────────────────────────────────────────────────────
# Local Postgres 16 container (recommended — no pooler/latency issues).
# The app container resolves `postgres` via the compose network; host-side
# one-off commands should use 127.0.0.1:5433 instead.
DATABASE_URL=postgresql://pastq:change-me@postgres:5432/pastq

# ── Object storage (private PDFs + rendered pages) ───────────────────
# Default: the box's existing MinIO (create a bucket + access key in the
# MinIO console — minio-console.podiumclass.online — e.g. bucket "pastq").
# From the app container, the public endpoint works and needs no extra
# network wiring:
S3_ENDPOINT=https://storage.podiumclass.online
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio-access-key-id
S3_SECRET_ACCESS_KEY=minio-secret-access-key
S3_BUCKET=pastq
#
# Alternative: Cloudflare R2 (bucket "pastq-privat") — same five vars:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto

# ── App ──────────────────────────────────────────────────────────────
# Canonical origin (no trailing slash) — used for watermark/PDF URLs and
# payment callbacks. Must match the nginx server_name.
APP_ORIGIN=https://academic.yourdomain.com

# Any long random string, e.g. `openssl rand -hex 32`.
PAGE_TOKEN_SECRET=change-me

# "mock" (default) = built-in sandbox gateway, completes instantly.
# Live gateway: use Paystack with the matching live keys from Lite-LMS.
PAYMENT_PROVIDER=paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Legacy Moolre variables are intentionally unused during the Paystack cutover.
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
