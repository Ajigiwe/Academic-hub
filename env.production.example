APP_NAME="Academic Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# cPanel prefixes database + user names with your account name —
# use the FULL prefixed names (e.g. cpuser_academichub).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_academichub
DB_USERNAME=cpuser_academichub
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# Paystack LIVE keys for production
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ── Email / SMTP Configuration ────────────────────────────────────────
# Wrap MAIL_PASSWORD in double quotes if it contains #, $, or spaces.
# Test delivery anytime without SSH in: Admin Panel -> Settings -> Email & SMTP
#
# Option 1 (Recommended for cPanel): SSL on Port 465
MAIL_MAILER=smtp
MAIL_HOST=mail.amgacademichub.com
MAIL_PORT=465
MAIL_USERNAME=support@amgacademichub.com
MAIL_PASSWORD="your_cpanel_email_password_here"
MAIL_ENCRYPTION=ssl
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=support@amgacademichub.com
MAIL_FROM_NAME="Academic Hub"

# Option 2 (Alternative): TLS on Port 587
# MAIL_MAILER=smtp
# MAIL_HOST=mail.amgacademichub.com
# MAIL_PORT=587
# MAIL_USERNAME=support@amgacademichub.com
# MAIL_PASSWORD="your_cpanel_email_password_here"
# MAIL_ENCRYPTION=tls
# MAIL_SCHEME=smtp
# MAIL_FROM_ADDRESS=support@amgacademichub.com
# MAIL_FROM_NAME="Academic Hub"

# ── Deploy Engine ─────────────────────────────────────────────────────
DEPLOY_BRANCH=main
DEPLOY_REMOTE=origin
DEPLOY_WEBHOOK_SECRET=generate_a_strong_random_secret_here
DEPLOY_PUBLIC_PATH=/home/CPUSER/public_html
