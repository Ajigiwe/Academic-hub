# Laravel keepfiles
!.gitignore

/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.npm
.DS_Store
Thumbs.db

# local binaries / data for the portable dev services (postgres + minio)
/services/data
/services/minio/*.exe

# local composer runner (never shipped)
/composer.phar

# freebuff tooling
/.freebuff/
